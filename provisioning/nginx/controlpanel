# Install as /etc/nginx/sites-available/controlpanel, then:
#   ln -s /etc/nginx/sites-available/controlpanel /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
server {
    listen 85;
    server_name minipc;

    root /home/gemini/websites/ControlPanel/public;
    index index.php;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        # Wake waits up to 45 s for the PC to answer a ping (CP_WAKE_WAIT);
        # nginx's 60 s default would 504 just before it gives up.
        fastcgi_read_timeout 90s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
