APP_NAME=ControlPanel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8085

# --- Control panel -----------------------------------------------------------
CP_ADMIN_NAME=Admin
CP_ADMIN_EMAIL=admin@controlpanel.local
CP_ADMIN_PASSWORD=change-me-please
CP_ALLOWED_CIDRS="192.168.0.0/24,127.0.0.1/32,::1/128"
CP_WOL_BROADCAST=192.168.0.255
CP_WOL_PORT=9
CP_WIN_HOST=192.168.0.197
CP_WIN_USER=binar
CP_WIN_MAC=34:5A:60:BB:6F:81
CP_BIN_DIR=/opt/controlpanel/bin
# Comma-separated action ids to disable (greyed out), e.g. mini.reboot,win.sleep
CP_DISABLED_ACTIONS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/testing/dusk.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local dev: run async actions inline. On the mini-PC set this to "redis"
# and run the Supervisor queue worker (see provisioning/).
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
